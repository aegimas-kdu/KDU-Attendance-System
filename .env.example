# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API.
#
# .env.local is git-ignored. Never commit real values.

# Safe to expose to the browser — Supabase says so explicitly, because Row
# Level Security is what actually protects the data. It ends up in the client
# bundle by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVER ONLY. The secret key bypasses Row Level Security completely — every
# policy in supabase/migrations stops applying to anyone holding it.
# Never import it into a client component, never prefix it with NEXT_PUBLIC_,
# and never commit it. Leave it blank until something genuinely needs it;
# nothing in this project does yet.
SUPABASE_SECRET_KEY=
