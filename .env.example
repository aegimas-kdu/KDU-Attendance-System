# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API.
#
# .env.local is git-ignored. Never commit real values.

# Safe to expose to the browser. Protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses Row Level Security completely — every policy
# in supabase/migrations stops applying to anyone holding this.
# Never import it into a client component, and never commit it.
# Leave it blank until something actually needs it.
SUPABASE_SERVICE_ROLE_KEY=
